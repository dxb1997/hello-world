# Python Basics Refresher - Essential for ML

# 1. Lists and List Comprehensions
data = [1, 2, 3, 4, 5]
squared_data = [x**2 for x in data]
print("Original data:", data)
print("Squared data:", squared_data)

# 2. Dictionaries - Great for storing features
student = {
    'name': 'Alice',
    'age': 25,
    'grades': [85, 90, 88, 92]
}
print(f"\nStudent: {student['name']}, Average grade: {sum(student['grades'])/len(student['grades'])}")

# 3. Functions - Essential for organizing ML code
def calculate_mean(numbers):
    """Calculate the mean of a list of numbers"""
    return sum(numbers) / len(numbers)

def calculate_variance(numbers):
    """Calculate the variance of a list of numbers"""
    mean = calculate_mean(numbers)
    return sum((x - mean) ** 2 for x in numbers) / len(numbers)

# Test our functions
test_data = [2, 4, 6, 8, 10]
print(f"\nData: {test_data}")
print(f"Mean: {calculate_mean(test_data)}")
print(f"Variance: {calculate_variance(test_data)}")

# 4. Working with Files - Important for loading datasets
import os

# Create a sample dataset
sample_data = """Name,Age,Height,Weight
Alice,25,165,55
Bob,30,175,70
Charlie,35,180,75
Diana,28,160,50"""

with open('sample_data.txt', 'w') as f:
    f.write(sample_data)

# Read the data
with open('sample_data.txt', 'r') as f:
    content = f.read()
    print("\nSample dataset:")
    print(content)

# Clean up
os.remove('sample_data.txt')# Chapter 2: Python Fundamentals for Machine Learning

